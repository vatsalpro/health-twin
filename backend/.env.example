# PregTwin Environment Configuration
# Copy this file to .env and configure secrets accordingly.

# Application & Security
PROJECT_NAME="PregTwin Maternal Digital Twin Platform"
SECRET_KEY=pregtwin-secure-research-secret-key-3.14-jwt-token-seed-2026
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Persistence
DATABASE_URL=sqlite:///./pregtwin.db
STORAGE_BACKEND=local
STORAGE_PATH=./storage/documents

# AI Provider Configuration
# Supported providers: openai, ollama, or fallback (deterministic clinical rules)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional Local Ollama Provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# OCR Engine Configuration
OCR_ENGINE=tesseract
TESSERACT_CMD=

# Research & Demonstration Mode
DEMO_MODE=true
DEFAULT_PREDICTION_HORIZON_DAYS=14
