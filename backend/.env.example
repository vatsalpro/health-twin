# PregTwin Environment Configuration Template
# Copy this file to .env and configure secrets accordingly.
# NEVER commit populated .env files into version control.

# Application & Security
ENVIRONMENT=development
PROJECT_NAME="PregTwin Maternal Digital Twin Platform"

# SECRET_KEY: Must be a cryptographically strong, random secret in production (e.g. openssl rand -hex 32).
# Rotating this key will invalidate all active JWT access tokens; sessions will need to re-authenticate.
# In production (ENVIRONMENT=production), startup will fail if SECRET_KEY is missing or set to a known development default.
SECRET_KEY=

# CORS Configuration (comma-separated or JSON list of authorized origins)
# Never use wildcard '*' with allow_credentials=True in production.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Persistence
DATABASE_URL=sqlite:///./pregtwin.db
STORAGE_BACKEND=local
STORAGE_PATH=./storage/documents

# AI Provider Configuration
# Supported providers: ollama (local, default), openai, or fallback (deterministic clinical rules)
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Local Ollama Provider (calls http://localhost:11434; model can be stored on any drive e.g. E:)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180.0

# Crane AI Chatbot Exclusive Requesty Configuration
# Used EXCLUSIVELY by Dr. Crane AI Chatbot (All other AI features use Ollama)
CRANE_AI_REQUESTY_API_KEY=your_requesty_api_key_here
CRANE_AI_REQUESTY_BASE_URL=https://router.requesty.ai/v1
CRANE_AI_REQUESTY_MODEL=google/gemma-4-31b-it
CRANE_AI_REQUESTY_TIMEOUT_SECONDS=45.0

# OCR Engine Configuration
OCR_ENGINE=tesseract
TESSERACT_CMD=

# Research & Demonstration Mode
DEMO_MODE=true
DEFAULT_PREDICTION_HORIZON_DAYS=14
